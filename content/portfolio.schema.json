{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnasie.dev/schemas/portfolio.schema.json",
  "title": "Portfolio Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "site", "navigation", "socials", "home", "projects", "writing", "terminal", "articles", "images"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageTitle",
        "pageDescription",
        "promptUser",
        "promptHost",
        "welcomeBanner",
        "helpIntro",
        "switchToVisualLabel",
        "switchToVisualHref",
        "navLabel"
      ],
      "properties": {
        "pageTitle": { "type": "string" },
        "pageDescription": { "type": "string" },
        "promptUser": { "type": "string" },
        "promptHost": { "type": "string" },
        "welcomeBanner": { "type": "array", "items": { "type": "string" } },
        "helpIntro": { "type": "string" },
        "switchToVisualLabel": { "type": "string" },
        "switchToVisualHref": { "type": "string", "minLength": 1 },
        "navLabel": { "type": "string" }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "issueLabel", "title", "titleTemplate", "description", "openGraph", "icons"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "issueLabel": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "titleTemplate": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "openGraph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "locale"],
          "properties": { "type": { "type": "string" }, "locale": { "type": "string" } }
        },
        "icons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["iconPng", "iconSvg", "favicon"],
          "properties": {
            "iconPng": { "$ref": "#/$defs/imageId" },
            "iconSvg": { "$ref": "#/$defs/imageId" },
            "favicon": { "$ref": "#/$defs/imageId" }
          }
        }
      }
    },
    "navigation": { "type": "array", "items": { "$ref": "#/$defs/navItem" } },
    "socials": { "type": "array", "items": { "$ref": "#/$defs/social" } },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "avatarImage", "heroTitle", "heroDescription", "actions", "projectHeading", "projectCountLabel", "projectMore", "projectCardAriaPrefix", "projectStatuses", "writingHeading", "viewAllArticles", "viewAllArticlesHref", "contactHeading", "contactDescription", "contactFallbackEmail", "contactEmailLabel", "copyEmail", "copiedEmail", "linksLabel"],
      "properties": {
        "availability": {
          "type": "string",
          "enum": [
            "Open to Opportunities",
            "Available for Full-time",
            "Available for Freelance",
            "Limited Availability",
            "Exploring Ideas",
            "Unavailable / Busy"
          ]
        },
        "avatarImage": { "$ref": "#/$defs/imageId" },
        "heroTitle": { "type": "string", "minLength": 1 },
        "heroDescription": { "type": "string" },
        "actions": {
          "type": "array", "minItems": 2,
          "items": { "type": "object", "additionalProperties": false, "required": ["label", "href"], "properties": { "label": { "type": "string" }, "href": { "type": "string" } } }
        },
        "projectHeading": { "type": "string" },
        "projectCountLabel": { "type": "string" },
        "projectMore": { "type": "string" },
        "projectCardAriaPrefix": { "type": "string" },
        "projectStatuses": {
          "type": "object", "additionalProperties": false,
          "required": ["featured", "active", "experimental", "archived", "early", "concept", "maintenance"],
          "properties": {
            "featured": { "type": "string" },
            "active": { "type": "string" },
            "experimental": { "type": "string" },
            "archived": { "type": "string" },
            "early": { "type": "string" },
            "concept": { "type": "string" },
            "maintenance": { "type": "string" }
          }
        },
        "customSections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "description", "items"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "description"],
                  "properties": {
                    "title": { "type": "string", "minLength": 1 },
                    "description": { "type": "string" },
                    "meta": { "type": "string" },
                    "link": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "writingHeading": { "type": "string" },
        "viewAllArticles": { "type": "string" },
        "viewAllArticlesHref": { "type": "string", "minLength": 1 },
        "contactHeading": { "type": "string" },
        "contactDescription": { "type": "string" },
        "contactFallbackEmail": { "type": "string", "format": "email" },
        "contactEmailLabel": { "type": "string" },
        "copyEmail": { "type": "string" },
        "copiedEmail": { "type": "string" },
        "linksLabel": { "type": "string" }
      }
    },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "writing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageTitle", "pageDescription", "articleTitleSuffix", "backToHome", "backToHomeHref", "archiveEyebrow", "pageHeading", "pageIntro", "backToWriting", "backToWritingHref", "featureLabel", "hashnodeLink", "hashnodeLinkHref", "readOnHashnode", "readOnHashnodeHref", "allArticles", "allArticlesHref", "articleNotFound", "projectModalClose", "projectModalTitle", "builtWith", "viewOnGitHub", "liveDemo", "themeToggleLabel", "lightThemeTitle", "darkThemeTitle", "homeAriaLabel", "primaryNavigationLabel", "socialLinkAriaSuffix"],
      "properties": {
        "pageTitle": { "type": "string" },
        "pageDescription": { "type": "string" },
        "articleTitleSuffix": { "type": "string" },
        "backToHome": { "type": "string" },
        "backToHomeHref": { "type": "string", "minLength": 1 },
        "archiveEyebrow": { "type": "string" },
        "pageHeading": { "type": "string" },
        "pageIntro": { "type": "string" },
        "backToWriting": { "type": "string" },
        "backToWritingHref": { "type": "string", "minLength": 1 },
        "featureLabel": { "type": "string" },
        "hashnodeLink": { "type": "string" },
        "hashnodeLinkHref": { "type": "string", "minLength": 1 },
        "readOnHashnode": { "type": "string" },
        "readOnHashnodeHref": { "type": "string", "minLength": 1 },
        "allArticles": { "type": "string" },
        "allArticlesHref": { "type": "string", "minLength": 1 },
        "articleNotFound": { "type": "string" },
        "projectModalClose": { "type": "string" },
        "projectModalTitle": { "type": "string" },
        "builtWith": { "type": "string" },
        "viewOnGitHub": { "type": "string" },
        "liveDemo": { "type": "string" },
        "themeToggleLabel": { "type": "string" },
        "lightThemeTitle": { "type": "string" },
        "darkThemeTitle": { "type": "string" },
        "homeAriaLabel": { "type": "string" },
        "primaryNavigationLabel": { "type": "string" },
        "socialLinkAriaSuffix": { "type": "string" }
      }
    },
    "articles": { "type": "array", "items": { "$ref": "#/$defs/article" } },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mimeType", "data", "alt", "width", "height", "generatedFile"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "mimeType": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/svg+xml",
              "image/x-icon",
              "image/gif",
              "image/avif",
              "video/mp4",
              "video/webm",
              "video/ogg"
            ]
          },
          "data": { "type": "string", "minLength": 1, "maxLength": 30000000 },
          "alt": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "generatedFile": { "type": "string", "pattern": "^/generated-content/[a-z0-9][a-z0-9._-]*$" }
        }
      }
    }
  },
  "$defs": {
    "imageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "navItem": { "type": "object", "additionalProperties": false, "required": ["label", "href"], "properties": { "label": { "type": "string" }, "href": { "type": "string" }, "external": { "type": "boolean" } } },
    "social": { "type": "object", "additionalProperties": false, "required": ["label", "href"], "properties": { "label": { "type": "string" }, "href": { "type": "string" }, "handle": { "type": "string" } } },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "description", "longDescription", "tags", "status", "year", "repoUrl"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "longDescription": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["featured", "active", "experimental", "archived", "early", "concept", "maintenance"] },
        "year": { "type": "string" },
        "repoUrl": { "type": "string", "format": "uri" },
        "demoUrl": { "type": "string", "format": "uri" },
        "image": { "$ref": "#/$defs/imageId" },
        "proofOfWork": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mediaType": { "type": "string", "enum": ["image", "video", "auto"] },
            "imageId": { "type": "string", "pattern": "^(?:|[a-z0-9][a-z0-9-]*)$" },
            "url": { "type": "string" },
            "posterImageId": { "type": "string", "pattern": "^(?:|[a-z0-9][a-z0-9-]*)$" },
            "posterUrl": { "type": "string" },
            "caption": { "type": "string" },
            "alt": { "type": "string" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "article": {
      "type": "object", "additionalProperties": false,
      "required": ["slug", "title", "excerpt", "date", "readingTime", "category", "tags", "featured", "externalRedirect", "body"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "readingTime": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "canonicalUrl": { "type": "string", "format": "uri" },
        "featured": { "type": "boolean" },
        "externalRedirect": { "type": "boolean" },
        "body": { "type": "string" }
      }
    }
  }
}